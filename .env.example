# API-Football konfiguráció
# Szerezz API kulcsot: https://www.api-football.com/
API_FOOTBALL_KEY=your_api_key_here

# Adatbázis konfiguráció
DATABASE_URL=sqlite:///predictions.db

# API kérés konfiguráció
REQUEST_TIMEOUT=15
MAX_RETRIES=3
API_BASE_URL=https://v3.football.api-sports.io

# Logging
LOG_LEVEL=INFO
