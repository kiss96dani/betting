# API-Football Configuration
API_FOOTBALL_KEY=your_api_key_here
API_BASE_URL=https://v3.football.api-sports.io

# Odds API (optional)
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# General Settings
LOG_LEVEL=INFO
REQUEST_TIMEOUT=15
PARALLEL_CONNECTIONS=6
SAVE_RAW=1
DATA_ROOT=.
LOCAL_TZ=Europe/Budapest

# Prediction Parameters
HOME_ADV=0.20
DRAW_BASE=0.25
KELLY_FRACTION_LIMIT=0.25
MISSING_TOP_SCORER_PCT=0.10

# Weighting Factors
FORM_WEIGHT=0.30
ATK_WEIGHT=0.35
DEF_WEIGHT=0.20

# Fetch and Analysis
FETCH_DAYS_AHEAD=3
BANKROLL_DAILY=1000
MAX_SINGLE_STAKE_FRACTION=0.05
KELLY_STAKE_MULTIPLIER=0.5

# Enhanced Modeling
ENABLE_ENHANCED_MODELING=1
ENABLE_CALIBRATION=1
ENABLE_BAYES=1
ENABLE_MC=1
MC_SIMS=12000

# Calibration
CALIBRATION_HISTORY_FILE=calibration_history.json
BAYES_HISTORY_DAYS=60

# Edge and Odds Limits
EDGE_CAP_1X2=1.0
EDGE_CAP_BTTs_OU=1.0
TICKET_MAX_ODDS_1X2=4.0
TICKET_MAX_ODDS_2WAY=4.0
TICKET_DIFF_TOL_1X2=0.15
TICKET_DIFF_TOL_2WAY=0.22
TICKET_FALLBACK_ENABLE=1
TICKET_FALLBACK_DIFF_TOL_2WAY=0.35
TICKET_BTTS_LAST_RESORT=1

# League Filtering
LEAGUE_WHITELIST=
LEAGUE_BLACKLIST=
MAJOR_LEAGUE_IDS=
MAJOR_LEAGUE_RATING_BOOST=0.05
MAJOR_LEAGUE_EDGE_BONUS=0.01

# Dynamic Leagues
ENABLE_DYNAMIC_LEAGUES=1
TOP_MODE=all
TIER_CONFIG_PATH=config/leagues_tiers.yaml

# Daily Reports
DAILY_REPORT_DIR=daily_reports
TICKET_ONLY_TODAY=1

# Maximum Odds for Picks
MAX_ODDS_1X2_PICKS=6.0
PICK_EDGE_CAP_1X2=1.0
